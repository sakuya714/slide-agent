#!/bin/zsh
# slide-kit
#   slide                 編集画面を開く（サーバーが止まっていれば起動する）
#   slide pdf  <資料>      PDF に書き出す（資料 = slide/deck/ からのパス 例：営業/〇〇社_提案）
#   slide pptx <資料>      PowerPoint で編集できる PPTX に書き出す
#   slide check <資料>     はみ出し・画像切れなどを調べる
#   slide new <フォルダ/資料名>   新しい資料を作る
#   slide stop / restart  サーバーを止める／起動し直す
ROOT="${0:A:h:h}"
PY="$ROOT/.venv/bin/python"
PORT="${SLIDE_KIT_PORT:-8770}"
URL="http://127.0.0.1:$PORT"
LOG="$HOME/Library/Logs/slide-kit.log"
[[ -x "$PY" ]] || { echo "環境が無い。$ROOT/install.sh を実行して"; exit 1; }

up()   { curl -fs "$URL/api/ping" >/dev/null 2>&1; }
stop() { local pids=$(lsof -ti tcp:$PORT -sTCP:LISTEN 2>/dev/null); [[ -n "$pids" ]] && kill ${=pids} && echo "■ 止めた"; }
start() {
  up && return 0
  mkdir -p "${LOG:h}"
  (cd "$ROOT" && nohup "$PY" -m server.cli serve --port "$PORT" >>"$LOG" 2>&1 &)
  for i in {1..50}; do up && return 0; sleep 0.1; done
  echo "✖ サーバーが起動しない。ログ: $LOG"; return 1
}

case "$1" in
  ""|open)  start && open "$URL${2:+#$("$PY" -c 'import sys,urllib.parse as u;print(u.quote(sys.argv[1]))' "$2")}" ;;
  stop)     stop ;;
  restart)  stop; sleep 0.5; start && echo "▶ $URL" ;;
  *)        cd "$ROOT" && exec "$PY" -m server.cli "$@" ;;
esac
